{
  "ExpressionEngine": "standard",
  "Resources": {},
  "Workflows": {
    "main": {
      "ExpressionEngine": "rules",
      "source": {
        "Type": "sample.source",
        "DiscardUnmatched": ["Output", "Events"],
        "messages": ["", "skip", "alpha", "beta"],
        "Output": { "Port": "upper.Input", "Condition": "hasText(text(input))" }
      },
      "upper": { "Type": "sample.uppercase", "DiscardUnmatched": ["Output", "Events"] },
      "sink": {
        "Type": "sample.sink",
        "DiscardUnmatched": ["Events"],
        "Input": {
          "Port": "upper.Output",
          "Condition": "text(input) != blocked",
          "Parameters": { "blocked": "SKIP" }
        }
      }
    }
  }
}
