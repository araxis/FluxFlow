{
  "Resources": {
    "messaging": {
      "broker": {
        "Type": "mqtt.broker",
        "Host": "localhost",
        "Port": 443,
        "Transport": "WebSocket",
        "UseTls": true,
        "WebSocketPath": "/mqtt"
      },
      "commands": {
        "Type": "mqtt.subscription",
        "Qos": "AtLeastOnce",
        "TopicFilter": "devices/+/state"
      },
      "configured": {
        "Type": "mqtt.client",
        "AutoConnect": "Disabled",
        "Broker": "Resources.messaging.broker",
        "ClientId": "composition-sample",
        "Reconnect": "Resources.messaging.retry",
        "Subscriptions": "Resources.messaging.commands"
      },
      "memory": {
        "Type": "host.external"
      },
      "retry": {
        "Type": "retry.policy"
      }
    }
  },
  "Workflows": {
    "main": {
      "source": {
        "Type": "sample.mqtt.publish-source",
        "Output": "outbound.Input"
      },
      "outbound": {
        "Type": "mqtt.publish",
        "Client": "Resources.messaging.memory",
        "maximumPendingRequests": 16
      }
    }
  }
}
