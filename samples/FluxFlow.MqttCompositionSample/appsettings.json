{
  "FluxFlow": {
    "Composition": {
      "workflows": {
        "main": {
          "nodes": {
            "source": {
              "type": "sample.mqtt.publish-source"
            },
            "outbound": {
              "type": "mqtt.publish",
              "resources": {
                "Client": "memory"
              },
              "configuration": {
                "maximumPendingRequests": 16
              }
            }
          },
          "links": [
            { "from": "source.Output", "to": "outbound.Input" }
          ]
        }
      }
    }
  }
}
