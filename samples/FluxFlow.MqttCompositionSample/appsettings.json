{
  "Resources": {
    "memory": {
      "Type": "host.external"
    }
  },
  "Workflows": {
    "main": {
      "source": {
        "Type": "sample.mqtt.publish-source",
        "Output": "outbound.Input"
      },
      "outbound": {
        "Type": "mqtt.publish",
