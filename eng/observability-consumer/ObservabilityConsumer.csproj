<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluxFlow.Observability.OpenTelemetry" Version="$(CandidateVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluxFlow.Observability.AspNetCore" Version="$(CandidateVersion)" />
  </ItemGroup>
  <Target Name="RequireCandidateVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(CandidateVersion)' == ''" Text="Supply CandidateVersion from a freshly packed local feed." />
  </Target>
</Project>
