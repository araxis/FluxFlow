<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Storage.FileSystem</PackageId>
    <AssemblyName>FluxFlow.Components.Storage.FileSystem</AssemblyName>
    <RootNamespace>FluxFlow.Components.Storage.FileSystem</RootNamespace>
    <Version>5.0.0</Version>
    <Description>File-system-backed storage adapter for FluxFlow storage components.</Description>
    <PackageTags>workflow;dataflow;components;storage;filesystem;files</PackageTags>
    <PackageReleaseNotes>Updates to immutable Storage 7.0.0 attribute contracts and removes redundant provider copies while preserving file-system persistence behavior.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Storage\FluxFlow.Components.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
