<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Storage</PackageId>
    <AssemblyName>FluxFlow.Components.Storage</AssemblyName>
    <RootNamespace>FluxFlow.Components.Storage</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone logical-storage nodes with canonical exact FlowContent operations, typed normal results, and preserved typed compatibility over host-owned stores.</Description>
    <PackageTags>workflow;dataflow;components;storage;records</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds canonical exact-content put/get/query/delete nodes with one typed normal-result output, stable result/error names, strong message lineage, and preserved released typed nodes.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="9.0.4" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
