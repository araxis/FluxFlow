<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Storage</PackageId>
    <AssemblyName>FluxFlow.Components.Storage</AssemblyName>
    <RootNamespace>FluxFlow.Components.Storage</RootNamespace>
    <Version>7.0.0</Version>
    <Description>Standalone logical-storage nodes with exact FlowContent operations and normal typed results over host-owned stores.</Description>
    <PackageTags>workflow;dataflow;components;storage;records</PackageTags>
    <PackageReleaseNotes>Makes storage attribute maps immutable ordinal snapshots across requests, records, queries, and results while preserving store and content behavior.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
