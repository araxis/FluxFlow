<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Sources.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Sources.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Sources.Composition</RootNamespace>
    <Version>2.2.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Canonical FlowValue generated and sequence source registration, Designer metadata, and typed compatibility helpers over host-owned clocks.</Description>
    <PackageTags>workflow;dataflow;components;sources;composition</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Centralizes canonical source aliases in typed descriptors and targets canonical addressable Events and semantic processing profile contracts.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Sources\FluxFlow.Components.Sources.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
