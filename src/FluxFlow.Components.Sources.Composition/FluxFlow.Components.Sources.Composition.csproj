<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Sources.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Sources.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Sources.Composition</RootNamespace>
    <Version>7.0.0-rc.1</Version>
    <Description>Typed generated and sequence source registration and Designer metadata over host-owned clocks.</Description>
    <PackageTags>workflow;dataflow;components;sources;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires source.items; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under SourcesComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Sources\FluxFlow.Components.Sources.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
