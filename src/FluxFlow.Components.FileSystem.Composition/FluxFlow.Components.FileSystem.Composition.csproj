<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.FileSystem.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.FileSystem.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.FileSystem.Composition</RootNamespace>
    <Version>7.0.0-rc.1</Version>
    <Description>FluxFlow.Composition registration and Designer metadata for typed file-system transforms and sources over host-owned keyed clocks.</Description>
    <PackageTags>workflow;dataflow;components;files;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires directory.list; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under FileSystemComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.FileSystem\FluxFlow.Components.FileSystem.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
