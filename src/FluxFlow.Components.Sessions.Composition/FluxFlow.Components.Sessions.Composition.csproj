<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Sessions.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Sessions.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Sessions.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Canonical session Composition registrations with exact FlowContent results, fixed ports, Designer metadata, and host-owned store resources.</Description>
    <PackageTags>workflow;dataflow;components;sessions;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires session.record; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under SessionsComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Sessions\FluxFlow.Components.Sessions.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
