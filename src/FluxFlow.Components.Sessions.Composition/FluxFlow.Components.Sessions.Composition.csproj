<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Sessions.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Sessions.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Sessions.Composition</RootNamespace>
    <Version>2.1.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Optional canonical session Composition registrations with exact FlowContent results, fixed ports, Designer metadata, and explicit typed compatibility paths.</Description>
    <PackageTags>workflow;dataflow;components;sessions;composition</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Renames the canonical session recorder type to session.record while retaining session.recorder as a hidden configuration alias.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Sessions\FluxFlow.Components.Sessions.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
