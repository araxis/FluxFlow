<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Data</PackageId>
    <AssemblyName>FluxFlow.Data</AssemblyName>
    <RootNamespace>FluxFlow.Data</RootNamespace>
    <Version>2.1.0</Version>
    <Description>Transport-neutral FlowError and exact immutable FlowContent contracts for FluxFlow.</Description>
    <PackageTags>workflow;dataflow;data;content;values</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds deterministic versioned FlowContent JSON serialization that preserves exact bytes, content type, and encoding.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
