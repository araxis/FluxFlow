<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Sources</PackageId>
    <AssemblyName>FluxFlow.Components.Sources</AssemblyName>
    <RootNamespace>FluxFlow.Components.Sources</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Standalone typed generated and sequence sources with deterministic timing and lifecycle events.</Description>
    <PackageTags>workflow;dataflow;components;sources</PackageTags>
    <PackageReleaseNotes>Migrates component inputs and outputs to typed FlowMessage&lt;T&gt; value-or-error contracts, removes universal FlowValue or FlowResult coupling, and keeps errors on the normal output.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
