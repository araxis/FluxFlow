<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Engine.DurableInput.SqlFile</PackageId>
    <AssemblyName>FluxFlow.Engine.DurableInput.SqlFile</AssemblyName>
    <RootNamespace>FluxFlow.Engine.DurableInput.SqlFile</RootNamespace>
    <Version>1.3.0</Version>
    <Description>SQLite single-file durable input store for FluxFlow.Engine.DurableInput.</Description>
    <PackageTags>workflow;dataflow;durability;inbox;sqlite;at-least-once</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Adds transactional bounded retention of delivered and dead-lettered durable inputs without a schema change.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Engine.DurableInput\FluxFlow.Engine.DurableInput.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
