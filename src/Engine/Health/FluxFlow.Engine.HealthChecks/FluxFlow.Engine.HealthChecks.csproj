<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Engine.HealthChecks</PackageId>
    <AssemblyName>FluxFlow.Engine.HealthChecks</AssemblyName>
    <RootNamespace>FluxFlow.Engine.HealthChecks</RootNamespace>
    <Version>2.0.0-rc.2</Version>
    <Description>Optional standard .NET readiness health check for FluxFlow application lifecycle and revision state.</Description>
    <PackageTags>workflow;dataflow;health-checks;readiness;hosting;operations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking dependency upgrade: rebuilt for the canonical runtime and event contracts. Adopt the coordinated package set and recompile consumers; no legacy compatibility transport is provided. Requires the corrected passive-observation runtime candidate.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/araxis/FluxFlow</PackageProjectUrl>
    <RepositoryUrl>https://github.com/araxis/FluxFlow</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Engine.HealthChecks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\FluxFlow.Engine\FluxFlow.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
