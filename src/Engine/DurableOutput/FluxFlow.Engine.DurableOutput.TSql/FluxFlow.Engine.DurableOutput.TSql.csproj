<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Engine.DurableOutput.TSql</PackageId>
    <AssemblyName>FluxFlow.Engine.DurableOutput.TSql</AssemblyName>
    <RootNamespace>FluxFlow.Engine.DurableOutput.TSql</RootNamespace>
    <Version>4.0.0-rc.2</Version>
    <Description>Production networked T-SQL durable-output capture, renewable leased delivery, dead-letter inspection, and generation-protected replay provider.</Description>
    <PackageTags>workflow;dataflow;durability;outbox;tsql;at-least-once;lease-renewal;dead-letter</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking dependency upgrade: rebuilt for the canonical runtime and event contracts. Adopt the coordinated package set and recompile consumers; no legacy compatibility transport is provided. Requires the corrected passive-observation runtime candidate.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Engine.DurableOutput.TSql.Tests" />
    <InternalsVisibleTo Include="FluxFlow.Engine.DurableOutput.TSql.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Engine.DurableOutput\FluxFlow.Engine.DurableOutput.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
