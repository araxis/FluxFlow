<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Serialization.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Serialization.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Serialization.Composition</RootNamespace>
    <Version>5.0.0</Version>
    <Description>FluxFlow.Composition registration and Designer metadata for explicit FlowContent, JSON, text, and Base64 conversions.</Description>
    <PackageTags>workflow;dataflow;components;serialization;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Updates the adapter dependency to the canonical-only Composition 6 surface without changing serialization runtime behavior.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Serialization\FluxFlow.Components.Serialization.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
