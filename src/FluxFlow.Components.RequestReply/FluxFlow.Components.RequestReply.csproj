<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.RequestReply</PackageId>
    <AssemblyName>FluxFlow.Components.RequestReply</AssemblyName>
    <RootNamespace>FluxFlow.Components.RequestReply</RootNamespace>
    <Version>2.0.0</Version>
    <Description>A transport-agnostic request/reply bridge for FluxFlow with compatibility correlation tracking over the shared coordination foundation.</Description>
    <PackageTags>workflow;dataflow;components;request-reply;trigger</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Migrates request/reply coordination to typed FlowMessage&lt;T&gt; outcomes while preserving correlation, timeout, capacity, and completion semantics.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Coordination\FluxFlow.Coordination.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
