<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Serialization</PackageId>
    <AssemblyName>FluxFlow.Components.Serialization</AssemblyName>
    <RootNamespace>FluxFlow.Components.Serialization</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Standalone explicit conversions among FlowContent, JSON, text, Base64, and typed workflow values, with value-or-error outputs and component events. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;serialization;json;base64;text</PackageTags>
    <PackageReleaseNotes>Migrates component inputs and outputs to typed FlowMessage&lt;T&gt; value-or-error contracts, removes universal FlowValue or FlowResult coupling, and keeps errors on the normal output.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
