<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Serialization</PackageId>
    <AssemblyName>FluxFlow.Components.Serialization</AssemblyName>
    <RootNamespace>FluxFlow.Components.Serialization</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone FluxFlow conversions between canonical FlowContent, FlowValue, JSON, text, and Base64, with normal FlowResult outcomes and legacy request-based nodes. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;serialization;json;base64;text</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds canonical FlowContent and FlowValue JSON, text, and Base64 nodes with one FlowResult output and stable workflow error codes. Legacy request-based nodes remain available.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
