<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Expectations</PackageId>
    <AssemblyName>FluxFlow.Components.Expectations</AssemblyName>
    <RootNamespace>FluxFlow.Components.Expectations</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone projection-event expectation nodes with canonical normal FlowResult outcomes and an explicit compatibility surface.</Description>
    <PackageTags>workflow;dataflow;components;events;expectations;monitoring</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds the canonical FlowEventExpectationNode with matched, unmet, timeout, completion, and expected evaluation failures represented through one normal FlowResult output. The existing EventExpectationNode remains available for compatibility.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Projections\FluxFlow.Components.Projections.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
