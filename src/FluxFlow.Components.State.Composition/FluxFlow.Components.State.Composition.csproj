<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.State.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.State.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.State.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Typed JSON state-reducer registration and Designer metadata over host-owned expression and clock resources.</Description>
    <PackageTags>workflow;dataflow;components;state;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires state.reduce; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under StateComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.State\FluxFlow.Components.State.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
    <ProjectReference Include="..\FluxFlow.Mapping\FluxFlow.Mapping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
