<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.State.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.State.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.State.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Typed JSON state-reducer registration and Designer metadata over host-owned expression and clock resources.</Description>
