<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Payloads</PackageId>
    <AssemblyName>FluxFlow.Components.Payloads</AssemblyName>
    <RootNamespace>FluxFlow.Components.Payloads</RootNamespace>
    <Version>5.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone FluxFlow payload inspection over canonical FlowContent, with reusable decoded FlowValue data, bounded previews, and normal FlowResult outcomes. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;payloads;inspection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Consolidates payload inspection on PayloadInspectNode with canonical FlowContent input, one FlowResult output, exact content preservation, reusable decoded FlowValue data, and normal error results. Removes the request DTO, temporary FlowContentInspectNode name, numeric error codes, and universal Errors output.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
