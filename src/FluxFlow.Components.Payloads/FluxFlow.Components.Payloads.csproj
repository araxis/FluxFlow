<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Payloads</PackageId>
    <AssemblyName>FluxFlow.Components.Payloads</AssemblyName>
    <RootNamespace>FluxFlow.Components.Payloads</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone FluxFlow payload inspection over canonical FlowContent, with reusable decoded FlowValue data, bounded previews, normal FlowResult outcomes, and a legacy request-based node. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;payloads;inspection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds canonical FlowContent inspection with one FlowResult output, reusable decoded FlowValue data, host-selectable codecs, and normal error results. The request-based PayloadInspectNode remains available for compatibility.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
