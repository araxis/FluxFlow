<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Coordination</PackageId>
    <AssemblyName>FluxFlow.Coordination</AssemblyName>
    <RootNamespace>FluxFlow.Coordination</RootNamespace>
    <Version>3.0.0-rc.1</Version>
    <Description>Transport-neutral pending exchange coordination for FluxFlow workflow and adapter packages.</Description>
    <PackageTags>workflow;dataflow;coordination;request-reply;acknowledgement;timeout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking dependency upgrade: rebuilt for the canonical runtime and event contracts. Adopt the coordinated package set and recompile consumers; no legacy compatibility transport is provided.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
