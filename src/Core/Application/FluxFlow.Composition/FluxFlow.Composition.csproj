<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Composition</PackageId>
    <AssemblyName>FluxFlow.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Composition</RootNamespace>
    <Version>8.0.0-rc.1</Version>
    <Description>Canonical FluxFlow application definitions, addressing, link compilation, component registration contracts, and keyed resource registration without depending on FluxFlow.Engine.</Description>
    <PackageTags>workflow;dataflow;composition;nodes</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking development preview: removes the secondary composition runtime and metadata type visitors; execute instance-first graphs through FluxFlow.Core. Port metadata is structural data; message and control bindings preserve canonical FlowMessage envelopes. Package migration and validation remain in progress.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Foundation\FluxFlow.Mapping\FluxFlow.Mapping.csproj" />
    <ProjectReference Include="..\..\FluxFlow.Core\FluxFlow.Core.csproj" />
    <ProjectReference Include="../../../Definition/FluxFlow.Json/FluxFlow.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Composition.Tests" />
    <InternalsVisibleTo Include="FluxFlow.Engine.Tests" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- On net10 Dataflow ships inbox; keep the explicit ref for net8 compat. -->
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
