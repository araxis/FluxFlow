<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Core</PackageId>
    <AssemblyName>FluxFlow.Core</AssemblyName>
    <RootNamespace>FluxFlow.Core</RootNamespace>
    <Version>1.0.0-alpha.1</Version>
    <Description>Instance-first application graph over canonical component blocks.</Description>
    <PackageTags>workflow;dataflow;components;coordination</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking development preview: consolidates foundation and exchange coordination into the instance-first application core. Runtime and package migration is still in progress; not a release candidate.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Composition" />
    <InternalsVisibleTo Include="FluxFlow.Engine" />
    <InternalsVisibleTo Include="FluxFlow.Core.Tests" />
    <InternalsVisibleTo Include="FluxFlow.Engine.Tests" />
    <InternalsVisibleTo Include="FluxFlow.Composition.Tests" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
