<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Serialization</PackageId>
    <AssemblyName>FluxFlow.Components.Serialization</AssemblyName>
    <RootNamespace>FluxFlow.Components.Serialization</RootNamespace>
    <Version>7.0.0-rc.1</Version>
    <Description>Standalone explicit conversions among FlowContent, JSON, text, Base64, and typed workflow values, with value-or-error outputs and component events. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;serialization;json;base64;text</PackageTags>
    <PackageReleaseNotes>Breaking dependency upgrade: rebuilt for the canonical runtime and event contracts. Adopt the coordinated package set and recompile consumers; no legacy compatibility transport is provided.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Foundation\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
