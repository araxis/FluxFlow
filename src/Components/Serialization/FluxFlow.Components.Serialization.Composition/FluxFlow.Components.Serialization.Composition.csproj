  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Serialization\FluxFlow.Components.Serialization.csproj" />
    <ProjectReference Include="..\..\..\Core\Application\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
