<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Routing</PackageId>
    <AssemblyName>FluxFlow.Components.Routing</AssemblyName>
    <RootNamespace>FluxFlow.Components.Routing</RootNamespace>
    <Version>8.0.0-alpha.1</Version>
    <Description>Standalone stateful routing components with component-local typed materialization and JSON specializations.</Description>
    <PackageTags>workflow;dataflow;components;routing</PackageTags>
    <PackageReleaseNotes>Unpublished development preview: all routing components use canonical ports and direct Core ownership without typed conversion queues. Join uses bounded native inputs and ordered shared-state processing. Authoring migration and final verification remain pending; this is not a release candidate.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\FluxFlow.Core\FluxFlow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Components.Routing.Tests" />
  </ItemGroup>
</Project>
