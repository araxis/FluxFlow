<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Routing</PackageId>
    <AssemblyName>FluxFlow.Components.Routing</AssemblyName>
    <RootNamespace>FluxFlow.Components.Routing</RootNamespace>
    <Version>7.0.0-rc.1</Version>
    <Description>Standalone typed Window, Correlation, and Join nodes for FluxFlow, including explicit JSON specializations.</Description>
    <PackageTags>workflow;dataflow;components;routing</PackageTags>
    <PackageReleaseNotes>Breaking dependency upgrade: rebuilt for the canonical runtime and event contracts. Adopt the coordinated package set and recompile consumers; no legacy compatibility transport is provided.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Foundation\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Components.Routing.Tests" />
  </ItemGroup>
</Project>
