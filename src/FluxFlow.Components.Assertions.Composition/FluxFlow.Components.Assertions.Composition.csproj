<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Assertions.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Assertions.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Assertions.Composition</RootNamespace>
    <Version>5.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Optional typed assertion registration and Designer metadata over host-owned keyed expression resources.</Description>
    <PackageTags>workflow;dataflow;components;assertions;composition</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Replaces registry registration with AddAssertionsComponents and DI-backed descriptors, metadata, and canonical component constants.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Assertions\FluxFlow.Components.Assertions.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
    <ProjectReference Include="..\FluxFlow.Mapping\FluxFlow.Mapping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
