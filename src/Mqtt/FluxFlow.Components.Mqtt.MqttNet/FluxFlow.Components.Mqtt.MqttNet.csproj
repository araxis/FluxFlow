<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Mqtt.MqttNet</PackageId>
    <AssemblyName>FluxFlow.Components.Mqtt.MqttNet</AssemblyName>
    <RootNamespace>FluxFlow.Components.Mqtt.MqttNet</RootNamespace>
    <Version>3.1.0</Version>
    <Description>Concrete MQTT transport adapter for FluxFlow. Maps resolved client configuration, exact message bytes, subscriptions, and broker acknowledgements while the provider-neutral MQTT core owns client policy and workflow behavior.</Description>
    <PackageTags>workflow;dataflow;components;mqtt;mqttnet</PackageTags>
    <PackageReleaseNotes>Maps the neutral FluxFlow broker configuration to TCP, TLS, WebSocket, and secure WebSocket MQTTnet channels.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Mqtt\FluxFlow.Components.Mqtt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Components.Mqtt.MqttNet.Tests" />
    <InternalsVisibleTo Include="FluxFlow.Components.Mqtt.Adapters.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MQTTnet" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
