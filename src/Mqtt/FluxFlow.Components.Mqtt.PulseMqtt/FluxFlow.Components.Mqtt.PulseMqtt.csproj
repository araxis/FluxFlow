<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Mqtt.PulseMqtt</PackageId>
    <AssemblyName>FluxFlow.Components.Mqtt.PulseMqtt</AssemblyName>
    <RootNamespace>FluxFlow.Components.Mqtt.PulseMqtt</RootNamespace>
    <Version>3.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Concrete MQTT transport adapter for FluxFlow. Maps resolved client configuration, exact message bytes, subscriptions, and broker acknowledgements while the provider-neutral MQTT core owns client policy and workflow behavior.</Description>
    <PackageTags>workflow;dataflow;components;mqtt;pulsemqtt</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Removes the legacy convenience client, adapter options, hosted registration, health, publisher, trigger, and provider-store APIs. The package now exposes only the provider transport factory over the MQTT 6 transport SPI; the core controller owns connection policy, reconnect, subscriptions, acknowledgements, and diagnostics.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Mqtt\FluxFlow.Components.Mqtt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Components.Mqtt.PulseMqtt.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Pulse.Mqtt.Client" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
