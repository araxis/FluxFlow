<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Http</PackageId>
    <AssemblyName>FluxFlow.Components.Http</AssemblyName>
    <RootNamespace>FluxFlow.Components.Http</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone FluxFlow HTTP nodes with canonical FlowContent request bodies, polymorphic response/error results, and released typed compatibility contracts.</Description>
    <PackageTags>workflow;dataflow;components;http</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds the canonical FlowContent HTTP client node with one polymorphic result output while preserving the released direct-use node and contracts.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
