<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Engine.DurableOutput</PackageId>
    <AssemblyName>FluxFlow.Engine.DurableOutput</AssemblyName>
    <RootNamespace>FluxFlow.Engine.DurableOutput</RootNamespace>
    <Version>4.0.0-rc.1</Version>
    <Description>Optional provider-neutral durable output capture, renewable leased at-least-once delivery, and dead-letter operations for FluxFlow.Engine.</Description>
    <PackageTags>workflow;dataflow;durability;outbox;capture;at-least-once;lease-renewal;dead-letter;replay</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Breaking: adds exact-token renewal to the cohesive delivery-store contract, replaces the four-argument options constructor, and requires a flat renewal interval; custom providers and direct options callers must update. No dependency was added.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FluxFlow.Engine.DurableOutput.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Engine\FluxFlow.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
