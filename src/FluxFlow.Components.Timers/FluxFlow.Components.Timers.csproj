<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Timers</PackageId>
    <AssemblyName>FluxFlow.Components.Timers</AssemblyName>
    <RootNamespace>FluxFlow.Components.Timers</RootNamespace>
    <Version>5.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone concise timer nodes for FluxFlow with immutable FlowValue ticks, normal FlowResult transform outcomes, Events, and an injected TimeProvider. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;timers</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Consolidates Timers on concise FlowValue and FlowResult nodes, removes typed tick and generic transform compatibility APIs, numeric errors, duplicate diagnostics, and universal Errors surfaces while preserving timing, lifecycle, diagnostics, and lineage.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
