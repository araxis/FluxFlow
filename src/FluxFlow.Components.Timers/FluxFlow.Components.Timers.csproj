<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Timers</PackageId>
    <AssemblyName>FluxFlow.Components.Timers</AssemblyName>
    <RootNamespace>FluxFlow.Components.Timers</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Standalone typed timer sources and transforms with deterministic clocks, value-or-error outputs, and component events. No engine required.</Description>
    <PackageTags>workflow;dataflow;components;timers</PackageTags>
    <PackageReleaseNotes>Migrates component inputs and outputs to typed FlowMessage&lt;T&gt; value-or-error contracts, removes universal FlowValue or FlowResult coupling, and keeps errors on the normal output.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
