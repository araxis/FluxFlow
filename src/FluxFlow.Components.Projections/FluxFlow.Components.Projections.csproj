<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Projections</PackageId>
    <AssemblyName>FluxFlow.Components.Projections</AssemblyName>
    <RootNamespace>FluxFlow.Components.Projections</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone event projection nodes with canonical normal-result snapshots and a direct-result compatibility surface.</Description>
    <PackageTags>workflow;dataflow;components;events;projections;monitoring</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds FlowEventProjectionNode with one normal FlowResult snapshot output, automatic ordered final snapshots, stable result/error kinds, and strong message lineage. The released EventProjectionNode remains available for compatibility.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
