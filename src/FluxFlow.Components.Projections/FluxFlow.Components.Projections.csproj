<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Projections</PackageId>
    <AssemblyName>FluxFlow.Components.Projections</AssemblyName>
    <RootNamespace>FluxFlow.Components.Projections</RootNamespace>
    <Version>7.0.0</Version>
    <Description>Standalone event projection nodes with canonical normal-result snapshots.</Description>
    <PackageTags>workflow;dataflow;components;events;projections;monitoring</PackageTags>
    <PackageReleaseNotes>Makes projection event, filter, summary, and snapshot attribute maps immutable ordinal snapshots while preserving filtering, rolling rates, lineage, diagnostics, JSON compatibility, and normal value-or-error output.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
