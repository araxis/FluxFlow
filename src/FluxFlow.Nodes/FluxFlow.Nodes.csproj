<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Nodes</PackageId>
    <AssemblyName>FluxFlow.Nodes</AssemblyName>
    <RootNamespace>FluxFlow.Nodes</RootNamespace>
    <Version>3.0.1</Version>
    <Description>Minimal typed TPL Dataflow node foundation with value-or-error messages, normal outputs, and diagnostic event streams. Nodes run standalone; no engine required.</Description>
    <PackageTags>workflow;dataflow;tpl;nodes</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Simplifies bounded node execution to one processing block while preserving backpressure, ordering, completion, cancellation, and diagnostics.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- On net10 Dataflow ships inbox; keep the explicit ref for net8 compat -->
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
