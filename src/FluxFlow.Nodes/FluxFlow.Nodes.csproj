<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Nodes</PackageId>
    <AssemblyName>FluxFlow.Nodes</AssemblyName>
    <RootNamespace>FluxFlow.Nodes</RootNamespace>
    <Version>4.0.0</Version>
    <Description>Minimal typed TPL Dataflow node foundation with transport-neutral FlowError and exact immutable FlowContent contracts. Nodes run standalone; no engine required.</Description>
    <PackageTags>workflow;dataflow;tpl;nodes;data;content</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Owns the transport-neutral FluxFlow.Data namespace alongside the node foundation, removing a package boundary while preserving source-level type names.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- On net10 Dataflow ships inbox; keep the explicit ref for net8 compat -->
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
