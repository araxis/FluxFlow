<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Observability.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Observability.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Observability.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Typed observability registration and Designer metadata over host-owned expression, selector, context, and clock resources.</Description>
    <PackageTags>workflow;dataflow;components;observability;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires canonical observability types and predicate; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under ObservabilityComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Observability\FluxFlow.Components.Observability.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
    <ProjectReference Include="..\FluxFlow.Mapping\FluxFlow.Mapping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
