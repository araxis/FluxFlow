<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Control</PackageId>
    <AssemblyName>FluxFlow.Components.Control</AssemblyName>
    <RootNamespace>FluxFlow.Components.Control</RootNamespace>
    <Version>5.0.0</Version>
    <Description>Migration package for control nodes replaced by canonical conditional workflow links.</Description>
    <PackageTags>workflow;dataflow;components;control</PackageTags>
    <PackageReleaseNotes>Removes Filter and When nodes after canonical conditional workflow links reached replacement parity. Migrate filtering and branching to link conditions before upgrading.</PackageReleaseNotes>
    <FluxFlowMigrationOnlyPackage>true</FluxFlowMigrationOnlyPackage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
