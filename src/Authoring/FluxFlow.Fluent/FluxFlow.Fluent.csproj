<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Fluent</PackageId>
    <AssemblyName>FluxFlow.Fluent</AssemblyName>
    <RootNamespace>FluxFlow.Fluent</RootNamespace>
    <Version>7.0.0-alpha.1</Version>
    <Description>Instance-first fluent pipelines over the canonical Core application with real component ports, branching and fan-in.</Description>
    <PackageTags>workflow;dataflow;composition;nodes;fluent;dsl</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Unpublished development preview: non-generic fluent chains register instances directly on Core. Removed executable descriptor factories, private host creation and artificial branch components. Portable authoring migration remains in progress; this is not a release candidate.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\FluxFlow.Core\FluxFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- On net10 Dataflow ships inbox; keep the explicit ref for net8 compat. -->
    <PackageReference Include="System.Threading.Tasks.Dataflow" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
