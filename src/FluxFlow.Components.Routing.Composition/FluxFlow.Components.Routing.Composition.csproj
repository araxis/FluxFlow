<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Routing.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Routing.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Routing.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Typed JSON routing registration and Designer metadata over host-owned selectors and clocks.</Description>
    <PackageTags>workflow;dataflow;components;routing;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Removes the flow.correlation type alias, requires flow.correlate, and updates the adapter to the canonical-only Composition 6 surface.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Routing\FluxFlow.Components.Routing.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
