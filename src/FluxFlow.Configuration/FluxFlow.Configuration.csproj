<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.0.0-alpha.1</Version>
    <PackageId>FluxFlow.Configuration</PackageId>
    <AssemblyName>FluxFlow.Configuration</AssemblyName>
    <RootNamespace>FluxFlow.Configuration</RootNamespace>
    <PackageTags>workflow;dataflow;configuration;composition</PackageTags>
    <Description>Configuration binding and component registration for FluxFlow applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Development preview: direct IConfiguration section registration for Scheduler, Gate, Source, Mapper, Router and Batch, with optional expression engines.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <ProjectReference Include="../FluxFlow.Core/FluxFlow.Core.csproj" />
    <ProjectReference Include="../Components/FluxFlow.Components.Batch/FluxFlow.Components.Batch.csproj" />
    <ProjectReference Include="../Components/FluxFlow.Components.Mapping/FluxFlow.Components.Mapping.csproj" />
    <ProjectReference Include="../Components/FluxFlow.Components.Scheduler/FluxFlow.Components.Scheduler.csproj" />
    <ProjectReference Include="../Components/FluxFlow.Components.Routing/FluxFlow.Components.Routing.csproj" />
    <ProjectReference Include="../Components/FluxFlow.Components.Source/FluxFlow.Components.Source.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
