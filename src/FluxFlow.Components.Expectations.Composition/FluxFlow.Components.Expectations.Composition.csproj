<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Expectations.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Expectations.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Expectations.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Canonical projection-event expectation registration and Designer metadata over exact host-owned clock addresses.</Description>
    <PackageTags>workflow;dataflow;components;events;expectations;composition</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Replaces registry registration with AddExpectationsComponents and DI-backed descriptors, metadata, and canonical component constants.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Expectations\FluxFlow.Components.Expectations.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Projections\FluxFlow.Components.Projections.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
    <ProjectReference Include="..\FluxFlow.Data\FluxFlow.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
