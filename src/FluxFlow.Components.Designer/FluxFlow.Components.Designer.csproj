<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Designer</PackageId>
    <AssemblyName>FluxFlow.Components.Designer</AssemblyName>
    <RootNamespace>FluxFlow.Components.Designer</RootNamespace>
    <Version>5.0.0</Version>
    <Description>Reusable component metadata and canonical application editing contracts for FluxFlow.</Description>
    <PackageTags>workflow;dataflow;components;metadata;designer</PackageTags>
    <PackageReleaseNotes>Removes alias metadata and fallback resolution; Designer now exposes only exact canonical component and resource type identities.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
