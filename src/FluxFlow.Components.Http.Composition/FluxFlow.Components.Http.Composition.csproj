<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Http.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Http.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Http.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Canonical HTTP FlowContent/result registration and Designer metadata over host-owned keyed HttpClient resources.</Description>
    <PackageTags>workflow;dataflow;components;http;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires http.request; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under HttpComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Http\FluxFlow.Components.Http.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
