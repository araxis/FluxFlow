<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>FluxFlow.Components.Sessions</PackageId>
    <AssemblyName>FluxFlow.Components.Sessions</AssemblyName>
    <RootNamespace>FluxFlow.Components.Sessions</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>FluxFlow contributors</Authors>
    <Description>Standalone canonical session recording, replay, and query nodes with exact FlowContent, typed normal results, and preserved typed compatibility over host-owned stores.</Description>
    <PackageTags>workflow;dataflow;components;sessions;recording;replay</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Adds canonical exact-content recorder/replay nodes and a one-output query node with typed normal results, stable result/error names, strong lineage, and preserved released typed nodes.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="System.Threading.Tasks.Dataflow" Version="9.0.4" NoWarn="NU1510" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
