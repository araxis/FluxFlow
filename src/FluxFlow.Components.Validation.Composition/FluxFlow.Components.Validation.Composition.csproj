<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Validation.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Validation.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Validation.Composition</RootNamespace>
    <Version>7.0.0-rc.1</Version>
    <Description>Optional FluxFlow.Composition registration and Designer metadata for explicit JsonElement JSON Schema validation.</Description>
    <PackageTags>workflow;dataflow;components;validation;json-schema;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Requires json.validate; registers exact descriptors and Designer metadata through the flat designed-component API; keeps constants under ValidationComponentDefinition and removes its metadata-only factory.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Validation\FluxFlow.Components.Validation.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
