<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Metrics</PackageId>
    <AssemblyName>FluxFlow.Components.Metrics</AssemblyName>
    <RootNamespace>FluxFlow.Components.Metrics</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Standalone metric aggregation nodes with canonical normal-result snapshots.</Description>
    <PackageTags>workflow;dataflow;components;metrics;rate;dashboard</PackageTags>
    <PackageReleaseNotes>Migrates component inputs and outputs to typed FlowMessage&lt;T&gt; value-or-error contracts, removes universal FlowValue or FlowResult coupling, and keeps errors on the normal output.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Nodes\FluxFlow.Nodes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
