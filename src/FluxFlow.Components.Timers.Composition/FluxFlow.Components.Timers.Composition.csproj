<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Components.Timers.Composition</PackageId>
    <AssemblyName>FluxFlow.Components.Timers.Composition</AssemblyName>
    <RootNamespace>FluxFlow.Components.Timers.Composition</RootNamespace>
    <Version>6.0.0</Version>
    <Description>Optional FluxFlow.Composition registrations and Designer metadata for typed timer sources and transforms over host-owned keyed clocks.</Description>
    <PackageTags>workflow;dataflow;components;timers;composition</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Registers exact timer descriptors and Designer metadata through the flat designed-component API; keeps constants under TimersComponentDefinition and removes its metadata-only factory without changing runtime behavior.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluxFlow.Components.Timers\FluxFlow.Components.Timers.csproj" />
    <ProjectReference Include="..\FluxFlow.Components.Designer\FluxFlow.Components.Designer.csproj" />
    <ProjectReference Include="..\FluxFlow.Composition\FluxFlow.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
