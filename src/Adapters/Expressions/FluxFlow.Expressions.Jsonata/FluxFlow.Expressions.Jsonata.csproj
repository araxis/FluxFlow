<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Expressions.Jsonata</PackageId>
    <AssemblyName>FluxFlow.Expressions.Jsonata</AssemblyName>
    <RootNamespace>FluxFlow.Expressions.Jsonata</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Optional JSONata expression-engine adapter for FluxFlow mapping components.</Description>
    <PackageTags>workflow;dataflow;mapping;expressions;jsonata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Introduces the optional JSONata adapter for the engine-free FluxFlow.Mapping contract.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Foundation\FluxFlow.Mapping\FluxFlow.Mapping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jsonata.Net.Native" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
