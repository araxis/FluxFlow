<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Expressions.CSharp</PackageId>
    <AssemblyName>FluxFlow.Expressions.CSharp</AssemblyName>
    <RootNamespace>FluxFlow.Expressions.CSharp</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Optional configured C# expression adapter for application conditions and mapping.</Description>
    <PackageTags>workflow;dataflow;mapping;expressions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Introduces host-configured C# expressions with typed per-evaluation parameters.</PackageReleaseNotes>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Foundation\FluxFlow.Mapping\FluxFlow.Mapping.csproj" />
    <PackageReference Include="DynamicExpresso.Core" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
