<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
<PackageId>FluxFlow.Observability.OpenTelemetry</PackageId>
    <AssemblyName>FluxFlow.Observability.OpenTelemetry</AssemblyName>
    <RootNamespace>FluxFlow.Observability.OpenTelemetry</RootNamespace>
    <PackageTags>workflow;dataflow;observability</PackageTags>
    <PackageReleaseNotes>Unpublished observability integration: lifecycle diagnostics, standard telemetry and host-owned export.</PackageReleaseNotes>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.0.0-alpha.1</Version>
    <Description>OpenTelemetry host registration for FluxFlow traces, metrics and diagnostic logs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FluxFlow.Observability/FluxFlow.Observability.csproj" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
