<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
<AssemblyName>FluxFlow.Observability</AssemblyName>
    <RootNamespace>FluxFlow.Observability</RootNamespace>
    <PackageTags>workflow;dataflow;observability</PackageTags>
    <PackageReleaseNotes>Unpublished observability integration: lifecycle diagnostics, standard telemetry and host-owned export.</PackageReleaseNotes>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>FluxFlow.Observability</PackageId>
    <Version>1.0.0-alpha.1</Version>
    <Description>Optional host-owned logging adapter for FluxFlow runtime diagnostics.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../Core/FluxFlow.Core/FluxFlow.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
