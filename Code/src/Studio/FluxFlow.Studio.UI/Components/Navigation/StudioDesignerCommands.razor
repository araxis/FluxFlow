@implements IDisposable

@code {
    [CascadingParameter] public StudioNavigation? Navigation { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    [Parameter] public bool CanRedo { get; set; }
    [Parameter] public EventCallback Undo { get; set; }
    [Parameter] public EventCallback Redo { get; set; }
    [Parameter] public Func<DockWorkspace>? Workspace { get; set; }
    [Parameter] public EventCallback Delete { get; set; }
    [Parameter] public bool CanDelete { get; set; }
    [Parameter] public EventCallback Fit { get; set; }
    [Parameter] public bool Workflow { get; set; }
    [Parameter] public EventCallback ToggleMinimap { get; set; }

    private (bool, bool, bool, bool, bool, bool, bool, bool)? _availability;
    protected override void OnParametersSet()
    {
        var availability = (CanUndo, CanRedo, CanDelete, Workflow, Workspace is not null, Delete.HasDelegate, Fit.HasDelegate, ToggleMinimap.HasDelegate);
        var changed = _availability != availability;
        _availability = availability;
        Navigation?.SetCommands(this, changed);
    }
    public void Dispose() => Navigation?.ClearCommands(this);
}
