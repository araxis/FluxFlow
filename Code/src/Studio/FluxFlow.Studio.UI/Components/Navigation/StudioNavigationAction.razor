@if (Overflow)
{
    <MudMenuItem Icon="@Icon" Disabled="@(Disabled || Loading)" OnClick="OnClick">@Label</MudMenuItem>
}
else
{
    <StudioIconButton Icon="@Icon" Label="@Label" Disabled="Disabled" Loading="Loading" Color="Color" OnClick="OnClick" />
}

@code {
    [CascadingParameter(Name = "NavigationOverflow")] public bool Overflow { get; set; }
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public EventCallback OnClick { get; set; }
}
