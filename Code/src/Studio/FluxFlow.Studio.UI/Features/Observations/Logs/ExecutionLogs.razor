@using FluxFlow.Environments
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Sections
@inject IJSRuntime JS
@implements IAsyncDisposable
@{
    var search = SearchText.Trim();
    var application = Application?.RunId == RunId ? Application : null;
    var filtered = ColumnFilters.Count > 0 || search.Length > 0 || RelatedSpan is not null || application is not null;
    var allRecords = Value.Records.Select(record => new ExecutionLogRow("Engine", record))
        .Concat(Diagnostics.Records.Select(record => new ExecutionLogRow("Runner", record))).ToArray();
    var records = allRecords
        .Where(item => search.Length == 0 || item.Record.Message.Contains(search, StringComparison.OrdinalIgnoreCase)
            || item.Record.Category.Contains(search, StringComparison.OrdinalIgnoreCase)
            || (item.Record.Exception?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false))
        .Where(item => RelatedSpan is null || (item.Record.Telemetry?.TraceId == RelatedSpan.TraceId &&
            (TraceOnly || item.Record.Telemetry?.SpanId == RelatedSpan.SpanId)))
        .Where(item => application is null || item.Record.Telemetry?.Attributes.Any(attribute =>
            attribute.Name == "flow.application.instance.id" && attribute.Value.ValueKind == JsonValueKind.String &&
            attribute.Value.GetString() == application.InstanceId) == true)
        .OrderBy(item => item.Record.Timestamp).ThenBy(item => item.Record.Sequence).ToArray();
    var matching = ApplyColumnFilters(records).ToArray();
    _matchingCount = matching.Length;
    var latest = matching.LastOrDefault();
    _visibleVersion = $"{RunId}:{_filterVersion}:{matching.Length}:{matching.Where(item => item.Source == "Engine").Select(item => item.Record.Sequence).DefaultIfEmpty().Max()}:{matching.Where(item => item.Source == "Runner").Select(item => item.Record.Sequence).DefaultIfEmpty().Max()}";
    var renderRun = RunId;
    var selectedRecord = SelectedRecord;
    var renderSelection = _selected;
}

<div class="execution-logs">
    @if (ToolbarSection is not null)
    { <SectionContent SectionId="ToolbarSection" ChildContent="Toolbar" /> }
    else
    { @Toolbar }
    @if (application is not null)
    {
        <div class="execution-log-filter telemetry-toolbar" aria-label="Application logs filter">
            <MudChip T="string" Size="Size.Small" OnClose="() => OnClearApplicationFilter.InvokeAsync()" title="@($"Application instance {application.InstanceId}")">@application.Name</MudChip>
        </div>
    }
    @if (RelatedSpan is { } related)
    {
        <div class="execution-log-filter telemetry-toolbar" aria-label="Related logs filter">
            <MudChip T="string" Size="Size.Small" OnClose="() => OnClearFilter.InvokeAsync()" title="@($"Trace {related.TraceId}; span {related.SpanId}")">@related.Name</MudChip>
            <StudioToolbarSelect T="bool" aria-label="Scope" title="Related logs scope" Value="TraceOnly" ValueChanged="TraceOnlyChanged">
                <MudSelectItem T="bool" Value="false">Selected span</MudSelectItem>
                <MudSelectItem T="bool" Value="true">Whole trace</MudSelectItem>
            </StudioToolbarSelect>
        </div>
    }
    <div class="execution-log-workspace @(selectedRecord is not null ? "with-details" : null)">
    <div class="execution-log-records" @ref="_viewport" data-log-layout="@($"{_filterVersion}:{search}:{RelatedSpan?.TraceId}:{RelatedSpan?.SpanId}:{TraceOnly}:{application?.InstanceId}")" tabindex="0" role="region" aria-label="Log records">
    @if (ReadError is not null) { <p role="status">@ReadError</p> }
    @if (Value.Dropped > 0) { <p role="status">@Value.Dropped older engine records are no longer in the buffer.</p> }
    @if (Diagnostics.Dropped > 0) { <p role="status">@Diagnostics.Dropped older runner records are no longer in the buffer.</p> }
        <StudioDataGrid T="ExecutionLogRow" @ref="_grid" Items="records" Class="execution-log-table" Filterable="true"
            FilterDefinitions="ColumnFilters" FilterChanged="FiltersChanged" SortChanged="SortChanged"
            RowClassFunc="RowClass"
            RowClick="args => SelectRecord(args.Item.Source, args.Item.Record.Sequence, renderRun)">
            <Columns>
                <PropertyColumn Property="item => item.Time" Title="Time (UTC)" InitialDirection="SortDirection.Ascending" ShowColumnOptions="false">
                    <CellTemplate><time datetime="@context.Item.Record.Timestamp.ToString("O")" title="@context.Item.Record.Timestamp.ToString("O")">@context.Item.Record.Timestamp.ToString("HH:mm:ss.fff zzz")</time></CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.Source" Title="Source" ShowColumnOptions="false">
                    <FilterTemplate><LogChoiceFilter Context="context" Values="allRecords.Select(item => item.Source)" Label="Source" /></FilterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.Severity" Title="Level" ShowColumnOptions="false">
                    <CellTemplate>@context.Item.Record.Level</CellTemplate>
                    <FilterTemplate><LogSeverityFilter Context="context" /></FilterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.Category" Title="Category" ShowColumnOptions="false">
                    <FilterTemplate><LogChoiceFilter Context="context" Values="allRecords.Select(item => item.Category)" Label="Category" /></FilterTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.Message" Title="Message" ShowColumnOptions="false">
                    <CellTemplate>
                        <button class="log-message" data-log-latest="@(context.Item == latest ? "true" : null)" aria-label="@($"Show details for {context.Item.Source} log {context.Item.Record.Sequence}")" aria-pressed="@((_selected == (context.Item.Source, context.Item.Record.Sequence)).ToString().ToLowerInvariant())">@context.Item.Record.Message</button>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="Trace" Sortable="false" Filterable="false">
                    <CellTemplate>
                        @{ var record = context.Item.Record; }
                        <div @onclick:stopPropagation="true">
                            @if (record.Telemetry is { TraceId: { Length: > 0 } traceId, SpanId: { Length: > 0 } spanId })
                            {
                                @if (_spans.TryGetValue((traceId, spanId), out var span))
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" aria-label="View trace" OnClick="() => OnViewTrace.InvokeAsync(span)">View trace</MudButton>
                                }
                                else
                                {
                                    <small title="The span has not been captured yet or is no longer in the buffer.">Span unavailable</small>
                                }
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </StudioDataGrid>
    @if (filtered && matching.Length == 0)
    {
        <div class="empty-observations" role="status">No retained logs match the current filters.</div>
    }
    </div>
    @if (selectedRecord is not null)
    {
        <aside @key="_selected" class="execution-log-detail-pane" aria-label="Log details">
            <div class="execution-log-detail-heading"><strong>Log details</strong>
                <TelemetryCopyButton @key="(renderRun, renderSelection)" GetText="() => CopyDetails(renderRun, renderSelection)" />
                <StudioIconButton Icon="@Icons.Material.Filled.Close" Label="Close log details" OnClick="ClearSelection" />
            </div>
            @if (!matching.Any(item => _selected == (item.Source, item.Record.Sequence)))
            { <p role="status">This record is hidden by the current filters.</p> }
            <ExecutionLogDetails Record="selectedRecord" Source="@(_selected!.Value.Source)" />
        </aside>
    }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ExecutionLogSnapshot Value { get; set; } = new([], 0);
    [Parameter] public ExecutionLogSnapshot Diagnostics { get; set; } = new([], 0);
    [Parameter] public ExecutionTraceSnapshot Traces { get; set; } = new([], 0);
    [Parameter] public EventCallback<ExecutionTrace> OnViewTrace { get; set; }
    [Parameter] public ExecutionTrace? RelatedSpan { get; set; }
    [Parameter] public bool TraceOnly { get; set; }
    [Parameter] public EventCallback<bool> TraceOnlyChanged { get; set; }
    [Parameter] public EventCallback OnClearFilter { get; set; }
    [Parameter] public ApplicationTelemetryTarget? Application { get; set; }
    [Parameter] public EventCallback OnClearApplicationFilter { get; set; }
    [Parameter] public List<IFilterDefinition<ExecutionLogRow>> ColumnFilters { get; set; } = [];
    [Parameter] public string SearchText { get; set; } = "";
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }
    [Parameter] public Guid? RunId { get; set; }
    [Parameter] public bool IsLive { get; set; }
    [Parameter] public string? ReadError { get; set; }
    [Parameter] public object? ToolbarSection { get; set; }
    private int _matchingCount;
    private MudMenu? _searchMenu;
    private RenderFragment? _toolbar;
    private RenderFragment Toolbar => _toolbar ??= @<div class="execution-log-toolbar" role="toolbar" aria-label="Log controls">
        <small aria-label="Log count">@_matchingCount / @(Value.Records.Count + Diagnostics.Records.Count) retained</small>
        <MudMenu @ref="_searchMenu" Icon="@Icons.Material.Filled.Search" Size="Size.Small" AriaLabel="Search logs" title="Search logs"
            Color="@(string.IsNullOrWhiteSpace(SearchText) ? Color.Default : Color.Primary)" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <div class="execution-log-search-popup telemetry-toolbar" @onclick:stopPropagation="true">
                <MudTextField T="string" Label="Search logs" Placeholder="Message, category or exception" Value="SearchText" ValueChanged="SearchTextChanged"
                    Immediate="true" Clearable="true" AutoFocus="true" Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="SearchKeyDown" />
            </div>
        </MudMenu>
        <StudioIconButton Icon="@Icons.Material.Outlined.FilterAltOff" Label="Clear filters"
            Disabled="@(ColumnFilters.Count == 0 && string.IsNullOrWhiteSpace(SearchText) && RelatedSpan is null && Application is null)" OnClick="ClearFilters" />
        <StudioIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowDown" Label="Follow latest" Pressed="_following"
            Color="@(_following ? Color.Primary : Color.Default)" OnClick="() => SetFollowing(!_following)" />
        <StudioIconButton Icon="@Icons.Material.Filled.VerticalAlignBottom" Label="Jump to latest" OnClick="JumpToLatest" />
    </div>;
    private Task SearchKeyDown(KeyboardEventArgs args) => args.Key == "Escape" && _searchMenu is not null
        ? _searchMenu.CloseMenuAsync() : Task.CompletedTask;
    private ElementReference _viewport;
    private MudDataGrid<ExecutionLogRow>? _grid;
    private long _filterVersion;
    private string? RowClass(ExecutionLogRow item, int index) => _selected == (item.Source, item.Record.Sequence) ? "log-selected" : null;
    internal IEnumerable<ExecutionLogRow> ApplyColumnFilters(IEnumerable<ExecutionLogRow> records)
    {
        foreach (var filter in ColumnFilters)
            records = records.Where(filter.GenerateFilterFunction(new FilterOptions { FilterCaseSensitivity = DataGridFilterCaseSensitivity.CaseInsensitive }));
        return records;
    }
    private void FiltersChanged() => _filterVersion++;
    private void SortChanged() => _filterVersion++;
    internal async Task ClearFilters()
    {
        if (_grid is not null) await _grid.ClearFiltersAsync();
        await OnClearFilters.InvokeAsync();
    }
    private IJSObjectReference? _module, _scroll;
    private DotNetObjectReference<ExecutionLogs>? _reference;
    private bool _following = true, _disposed;
    private string _visibleVersion = "";
    private (string Source, long Sequence)? _selected;
    private Guid? _selectionRun;
    private ExecutionLog? SelectedRecord => _selected is { } selection
        ? (selection.Source == "Engine" ? Value : Diagnostics).Records.FirstOrDefault(record => record.Sequence == selection.Sequence)
        : null;
    internal async Task SelectRecord(string source, long sequence, Guid? runId)
    {
        if (_disposed || runId != RunId || source is not ("Engine" or "Runner")) return;
        if (!(source == "Engine" ? Value : Diagnostics).Records.Any(record => record.Sequence == sequence)) return;
        _selected = (source, sequence);
        _selectionRun = runId;
        await SetFollowing(false);
        StateHasChanged();
    }
    internal void ClearSelection() => _selected = null;
    private string? CopyDetails(Guid? runId, (string Source, long Sequence)? selection)
    {
        if (_disposed || runId != RunId || selection is null || selection != _selected || SelectedRecord is not { } record) return null;
        return JsonSerializer.Serialize(record, EnvironmentJsonContext.Default.ExecutionLog);
    }
    internal async Task SetFollowing(bool value)
    {
        _following = value;
        if (_scroll is not null) await _scroll.InvokeVoidAsync("setFollowing", value);
    }
    private async Task JumpToLatest()
    {
        if (!_disposed && _scroll is not null) await _scroll.InvokeVoidAsync("jumpToLatest");
    }
    [JSInvokable]
    public Task PauseFollowing() => InvokeAsync(() =>
    {
        if (_disposed) return;
        _following = false;
        StateHasChanged();
    });
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/FluxFlow.Studio.UI/Features/Observations/Logs/ExecutionLogs.razor.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            _reference = DotNetObjectReference.Create(this);
            var following = _following;
            _scroll = await _module.InvokeAsync<IJSObjectReference>("create", _viewport, _reference, following);
            if (_disposed) { await ReleaseScroll(); return; }
            if (following != _following) await _scroll.InvokeVoidAsync("setFollowing", _following);
        }
        if (_scroll is not null) await _scroll.InvokeVoidAsync("update", IsLive, _visibleVersion);
    }
    private async ValueTask ReleaseScroll()
    {
        if (_scroll is not null)
        {
            await _scroll.InvokeVoidAsync("dispose");
            await _scroll.DisposeAsync();
            _scroll = null;
        }
        _reference?.Dispose();
        _reference = null;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await ReleaseScroll();
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _reference?.Dispose(); }
    }
    private readonly Dictionary<(string TraceId, string SpanId), ExecutionTrace> _spans = new();
    protected override void OnParametersSet()
    {
        if (_selectionRun != RunId || SelectedRecord is null) ClearSelection();
        _spans.Clear();
        foreach (var span in Traces.Records) _spans.TryAdd((span.TraceId, span.SpanId), span);
    }
}
