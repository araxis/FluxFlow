@using System.Text.Json
@using System.Text.Json.Nodes
@using FluxFlow.Application.Addressing
@implements IDisposable
@inject IDialogService Dialogs
@inject DesignerGraphState Graph
<ComponentJsonAction OnClick="OpenEditorAsync" Disabled="@(_busy || Disabled)" />
@code {
    [Parameter, EditorRequired] public IDictionary<string, JsonElement> Configuration { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private bool _busy, _disposed;
    private IDialogReference? _dialog;

    public async Task OpenEditorAsync()
    {
        if (Disabled || _busy || _disposed || !ReferenceEquals(Configuration, Graph.SelectedNode?.Configuration)) return;
        var original = Configuration;
        var revision = Graph.Revision;
        var address = ComponentAddress.Create(Graph.WorkflowName, Graph.SelectedNode!.NodeName);
        var type = Graph.SelectedNode.ComponentType;
        using var edit = Graph.BeginManualEdit();
        _busy = true;
        try
        {
            void Validate(JsonElement value) => ComponentJsonValidation.Validate(value, type, address, Graph.PluginValidators);
            _dialog = await Dialogs.ShowAsync<TextEditorDialog>($"{address.ComponentName} JSON",
                new DialogParameters<TextEditorDialog>
                {
                    { dialog => dialog.Value, JsonSerializer.Serialize(original, new JsonSerializerOptions { WriteIndented = true }) },
                    { dialog => dialog.Json, true },
                    { dialog => dialog.ValidateJson, (Action<JsonElement>)Validate },
                    { dialog => dialog.Help, "Component settings. Keep Type unchanged. Registration checks do not resolve resources or execute the component." }
                }, new DialogOptions { BackdropClick = false, CloseOnEscapeKey = true });
            if (_disposed) { _dialog.Close(DialogResult.Cancel()); return; }
            if (await _dialog.Result is not { Canceled: false, Data: string json } || _disposed ||
                Graph.Revision != revision || !ReferenceEquals(original, Graph.SelectedNode?.Configuration)) return;
            var value = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json)!;
            if (JsonNode.DeepEquals(JsonSerializer.SerializeToNode(original), JsonSerializer.SerializeToNode(value))) return;
            edit.Dispose();
            original.Clear();
            foreach (var pair in value) original[pair.Key] = pair.Value;
            await OnChanged.InvokeAsync();
        }
        finally { _busy = false; _dialog = null; }
    }

    public void Dispose() { _disposed = true; _dialog?.Close(DialogResult.Cancel()); }
}
