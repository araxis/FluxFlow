@if (Loading)
{
    <MudIconButton aria-label="@Label" title="@Label" Size="Size.Small" Disabled="true">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color" aria-label="Loading" />
    </MudIconButton>
}
else
{
    <MudIconButton Icon="@Icon" aria-label="@Label" aria-pressed="@(Pressed?.ToString().ToLowerInvariant())" title="@Label" Size="Size.Small" Disabled="Disabled" OnClick="OnClick" Color="Color" />
}
@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool? Pressed { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
}
