<MudDialog Class="@($"studio-dialog {Size}")" ContentClass="studio-dialog-content" DialogActions="@Actions">
    <TitleContent>
        <div class="studio-dialog-titlebar">
            <div class="studio-dialog-heading">
                <h2>@(Title ?? Dialog.Title)</h2>
                @if (!string.IsNullOrEmpty(Subtitle)) { <p>@Subtitle</p> }
            </div>
            @if (Toolbar is not null)
            {
                <div class="studio-dialog-toolbar" role="toolbar" aria-label="Dialog actions">@Toolbar</div>
            }
            <div class="studio-dialog-window-actions">
                @if (AllowFullScreen)
                {
                    <MudIconButton Size="MudBlazor.Size.Small" Icon="@(FullScreen ? Icons.Material.Outlined.FullscreenExit : Icons.Material.Outlined.Fullscreen)"
                               aria-label="Toggle full screen" title="Toggle full screen" OnClick="ToggleFullScreen" />
                }
                <MudIconButton Size="MudBlazor.Size.Small" Icon="@Icons.Material.Outlined.Close" aria-label="Close dialog" title="Close dialog" Disabled="CloseDisabled" OnClick="() => Dialog.Cancel()" />
            </div>
        </div>
    </TitleContent>
    <DialogContent>@ChildContent</DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Size { get; set; } = "medium";
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool AllowFullScreen { get; set; } = true;
    [Parameter] public bool CloseDisabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private bool _previousCloseDisabled;
    protected override void OnParametersSet()
    {
        if (_previousCloseDisabled == CloseDisabled) return;
        _previousCloseDisabled = CloseDisabled;
        // The title bar is rendered by the dialog container.
        Dialog.StateHasChanged();
    }

    private bool FullScreen => Dialog.Options.FullScreen == true;
    private Task ToggleFullScreen() => Dialog.SetOptionsAsync(Dialog.Options with { FullScreen = !FullScreen });
}
