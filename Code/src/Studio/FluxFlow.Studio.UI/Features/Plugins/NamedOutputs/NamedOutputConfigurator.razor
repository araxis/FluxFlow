@inherits ComponentConfiguratorComponent
@implements IDisposable
@using System.Text.Json
@using System.Text.Json.Nodes
@inject IDialogService Dialogs
@inject DesignerGraphState Graph
@using FluxFlow.Plugins
<OptionPropertyRows Sections="Sections" Configuration="Configuration" OnChanged="OnChanged" OnHelpChanged="OnHelpChanged" />
<tr class="property-section property-section-with-actions"><th colspan="2">
    <div class="property-section-heading"><span>@MapOption.DisplayName</span>
        <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" aria-label="@($"Add {Schema.EntryLabel}")" title="@($"Add {Schema.EntryLabel}")" OnClick="() => Edit(null)" Disabled="@(_busy || Entries is null)" />
    </div>
</th></tr>
@if (Entries is { } routes)
{
    @foreach (var route in routes)
    {
        <tr class="property-row"><th scope="row">@route.Name</th><td>
            <div class="named-output-value"><span title="@route.Value.ToString()">@route.Value.ToString()</span><div>
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="@($"Edit {Schema.EntryLabel} {route.Name}")" title="@($"Edit {Schema.EntryLabel}")" OnClick="() => Edit(route.Name)" Disabled="@(_busy || route.Value.ValueKind != JsonValueKind.String)" />
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="@($"Remove {Schema.EntryLabel} {route.Name}")" title="@($"Remove {Schema.EntryLabel}")" OnClick="() => Remove(route.Name)" Disabled="_busy" />
            </div></div>
        </td></tr>
    }
    @if (routes.Length == 0)
    { <tr class="property-row"><td colspan="2"><span class="readonly-value">No @MapOption.DisplayName.ToLowerInvariant()</span></td></tr> }
}
else
{ <tr class="property-row"><td colspan="2"><span class="readonly-value">Use JSON to edit this saved value.</span></td></tr> }
<tr class="property-row"><th scope="row">@MapOption.DisplayName JSON</th><td>
    <OptionEditorField @ref="_json" @key="(Configuration, _revision)" Option="MapOption" Configuration="Configuration" OnChanged="Changed" />
</td></tr>
@code {
    private bool _busy, _disposed;
    private int _revision;
    private IDialogReference? _dialog;
    private OptionEditorField? _json;
    private PluginComponent Description => (PluginComponent)Graph.FindDescription(Configuration.First(item => item.Key.Equals("Type", StringComparison.OrdinalIgnoreCase)).Value.GetString()!)!;
    private NamedExpressionOutputs Schema => Description.NamedOutputs!;
    private OptionEditorModel MapOption => Description.Inspector.Sections.SelectMany(section => section.Options).Single(option => option.Name == Schema.Property);
    private IReadOnlyList<OptionSectionModel> Sections => Description.Inspector.Sections.Select(section => section with
        { Options = section.Options.Where(option => option.Name != Schema.Property).ToArray() }).ToArray();
    private string Key => Configuration.Keys.FirstOrDefault(key => key.Equals(Schema.Property, StringComparison.OrdinalIgnoreCase)) ?? Schema.Property;
    private JsonProperty[]? Entries => !Configuration.TryGetValue(Key, out var value) ? []
        : value.ValueKind == JsonValueKind.Object ? value.EnumerateObject().ToArray() : null;
    private bool Current => !_disposed && ReferenceEquals(Configuration, Graph.SelectedNode?.Configuration);
    public override Task OpenEditorAsync() => Entries is null ? _json?.OpenEditorAsync() ?? Task.CompletedTask : Edit(null);
    private async Task Changed() { _revision++; await OnChanged.InvokeAsync(); }
    private async Task Edit(string? name)
    {
        if (_busy || !Current || Entries is not { } routes) return;
        var original = Configuration;
        var revision = Graph.Revision;
        var value = name is null ? "" : routes.Single(route => route.Name == name).Value.GetString()!;
        _busy = true;
        try
        {
            var reserved = Schema.ReservedNames;
            _dialog = await Dialogs.ShowAsync<NamedOutputDialog>($"{(name is null ? "Add" : "Edit")} {Schema.EntryLabel}", new DialogParameters<NamedOutputDialog>
            {
                { dialog => dialog.Name, name ?? "" }, { dialog => dialog.Expression, value }, { dialog => dialog.Existing, name is not null },
                { dialog => dialog.UnavailableNames, reserved.Concat(routes.Select(route => route.Name)).ToArray() }
            }, new DialogOptions { CloseOnEscapeKey = true, BackdropClick = false });
            if (await _dialog.Result is not { Canceled: false, Data: NamedOutputEdit choice } || !Current ||
                revision != Graph.Revision || !ReferenceEquals(original, Configuration)) return;
            if (name is not null && choice.Expression == value) return;
            var updated = JsonNode.Parse(original.TryGetValue(Key, out var saved) ? saved.GetRawText() : "{}")!.AsObject();
            updated[name ?? choice.Name] = choice.Expression;
            using var edit = Graph.BeginManualEdit();
            original[Key] = JsonSerializer.SerializeToElement(updated);
            await Changed();
        }
        finally { _busy = false; _dialog = null; }
    }
    private async Task Remove(string name)
    {
        if (_busy || !Current || Entries is null) return;
        var original = Configuration;
        var revision = Graph.Revision;
        _busy = true;
        try
        {
            _dialog = await Dialogs.ShowAsync<StudioMessageDialog>($"Remove {Schema.EntryLabel}", new DialogParameters<StudioMessageDialog>
                { { dialog => dialog.Message, "Remove this output? Saved links are retained and may need reconnecting. Undo restores the output." }, { dialog => dialog.Action, "Remove" } });
            if (await _dialog.Result is not { Canceled: false, Data: true } ||
                !Current || revision != Graph.Revision || !ReferenceEquals(original, Configuration)) return;
            var updated = JsonNode.Parse(original[Key].GetRawText())!.AsObject();
            if (!updated.Remove(name)) return;
            using var edit = Graph.BeginManualEdit();
            original[Key] = JsonSerializer.SerializeToElement(updated);
            await Changed();
        }
        finally { _busy = false; _dialog = null; }
    }
    public void Dispose() { _disposed = true; _dialog?.Close(DialogResult.Cancel()); }
}
