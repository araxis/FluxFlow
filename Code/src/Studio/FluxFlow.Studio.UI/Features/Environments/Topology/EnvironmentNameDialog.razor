@inject DesignerGraphState Graph

<StudioDialog Subtitle="Each environment has its own service setup and topology." Size="small" AllowFullScreen="false">
    <Actions><MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton><MudButton Color="Color.Primary" OnClick="Save">Add</MudButton></Actions>
    <ChildContent><MudTextField T="string" @bind-Value="_name" Label="Environment name" Variant="Variant.Outlined" Immediate="true" Error="@(_error is not null)" ErrorText="@_error" /></ChildContent>
</StudioDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private string _name = "";
    private string? _error;
    private void Save()
    {
        string name;
        try { name = Graph.ValidateNewEnvironmentName(_name); }
        catch (ArgumentException error) { _error = error.Message; return; }
        Dialog.Close(DialogResult.Ok(name));
    }
}
