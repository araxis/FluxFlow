<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0.100'))">net11.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <PackageId>FluxFlow.Sdk</PackageId>
    <ToolCommandName>fluxflow</ToolCommandName>
    <Version>1.0.0-alpha.3</Version>
    <Description>Generate and publish FluxFlow applications with the bundled family mappings and runtime packages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- The SDK ships a local NuGet feed, including the package archives themselves. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FluxFlow.Cli/FluxFlow.Cli.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(FluxFlowSdkFeed)' != ''">
    <_SdkPackage Include="$(FluxFlowSdkFeed)/FluxFlow.*.nupkg" Exclude="$(FluxFlowSdkFeed)/FluxFlow.Sdk.*.nupkg" />
    <None Include="@(_SdkPackage);$(FluxFlowSdkFeed)/NuGet.Config" Pack="true" PackagePath="tools/$(TargetFramework)/any/feed/" Visible="false" />
  </ItemGroup>
  <Target Name="RequireSdkFeed" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(TargetFramework)' != 'net11.0'" Text="Pack FluxFlow.Sdk with the repository's .NET 11 SDK." />
    <Error Condition="'@(_SdkPackage)' == '' or !Exists('$(FluxFlowSdkFeed)/NuGet.Config')" Text="Set FluxFlowSdkFeed to the published Studio app-generator/feed directory." />
  </Target>
</Project>
