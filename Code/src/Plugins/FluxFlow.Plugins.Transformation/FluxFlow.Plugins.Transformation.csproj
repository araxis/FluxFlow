<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks><Version>1.0.0-alpha.2</Version>
    <RootNamespace>FluxFlow.Authoring</RootNamespace>
    <PackageTags>fluxflow-plugin;workflow;mapping;aggregation</PackageTags><Description>Workflow mapping, state reduction and batching.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Runtime/**;Settings/**;Design/**;**/bin/**;**/obj/**</DefaultItemExcludes>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackTransformation</TargetsForTfmSpecificContentInPackage>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Design/FluxFlow.Plugins.Transformation.Design.csproj" PrivateAssets="all" />
    <ProjectReference Include="Runtime/FluxFlow.Components.Mapping.Fluent/FluxFlow.Components.Mapping.Fluent.csproj" PrivateAssets="all" />
    <ProjectReference Include="Runtime/FluxFlow.Components.Reducer.Fluent/FluxFlow.Components.Reducer.Fluent.csproj" PrivateAssets="all" />
    <ProjectReference Include="Runtime/FluxFlow.Components.Batch.Fluent/FluxFlow.Components.Batch.Fluent.csproj" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../../FluxFlow.Configuration/FluxFlow.Configuration.csproj" PrivateAssets="all" />
    <ProjectReference Include="../FluxFlow.Plugins/FluxFlow.Plugins.csproj" />
    <None Remove="fluxflow-plugin.json" />
    <None Include="fluxflow-plugin.json" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="PackTransformation">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)FluxFlow.Components.Mapping.dll;$(TargetDir)FluxFlow.Components.Mapping.Fluent.dll;$(TargetDir)FluxFlow.Components.Reducer.dll;$(TargetDir)FluxFlow.Components.Reducer.Fluent.dll;$(TargetDir)FluxFlow.Components.Batch.dll;$(TargetDir)FluxFlow.Components.Batch.Fluent.dll;$(TargetDir)FluxFlow.Plugins.Transformation.Design.dll" PackagePath="lib/$(TargetFramework)/" />
    </ItemGroup>
  </Target>
</Project>
