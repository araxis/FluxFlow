<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.0.0-alpha.2</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Typed workflow registration for ROS 2 node resources and std_msgs/String topics.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FluxFlow.Components.Ros2/FluxFlow.Components.Ros2.csproj" />
    <ProjectReference Include="../../../../FluxFlow.Configuration/FluxFlow.Configuration.csproj" />
    <None Remove="csharp-mapping.json" />
    <None Include="csharp-mapping.json" Pack="true" PackagePath="fluxflow/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="Messages/NOTICE.md;Messages/LICENSE" Pack="true" PackagePath="licenses/" />
  </ItemGroup>
</Project>
