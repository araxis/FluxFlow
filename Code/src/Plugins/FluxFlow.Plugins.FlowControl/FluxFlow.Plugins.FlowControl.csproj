<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks><Version>1.0.0-alpha.2</Version>
    <RootNamespace>FluxFlow.Authoring</RootNamespace>
    <PackageTags>fluxflow-plugin;workflow;flow-control;resilience</PackageTags><Description>Rate limiting, correlated request/reply and retries.</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);Runtime/**;Settings/**;Design/**;**/bin/**;**/obj/**</DefaultItemExcludes>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackFlowControl</TargetsForTfmSpecificContentInPackage>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Design/FluxFlow.Plugins.FlowControl.Design.csproj" PrivateAssets="all" />
    <ProjectReference Include="Runtime/FluxFlow.Components.RateLimit.Fluent/FluxFlow.Components.RateLimit.Fluent.csproj" PrivateAssets="all" />
    <ProjectReference Include="Runtime/FluxFlow.Components.Resilience.Fluent/FluxFlow.Components.Resilience.Fluent.csproj" PrivateAssets="all" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../../FluxFlow.Configuration/FluxFlow.Configuration.csproj" PrivateAssets="all" />
    <ProjectReference Include="../FluxFlow.Plugins/FluxFlow.Plugins.csproj" />
    <None Remove="fluxflow-plugin.json" />
    <None Include="fluxflow-plugin.json" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="PackFlowControl">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)FluxFlow.Components.RateLimit.dll;$(TargetDir)FluxFlow.Components.RateLimit.Fluent.dll;$(TargetDir)FluxFlow.Components.Resilience.dll;$(TargetDir)FluxFlow.Components.Resilience.Fluent.dll;$(TargetDir)FluxFlow.Plugins.FlowControl.Settings.dll;$(TargetDir)Polly.Core.dll;$(TargetDir)System.Threading.RateLimiting.dll;$(TargetDir)FluxFlow.Plugins.FlowControl.Design.dll" PackagePath="lib/$(TargetFramework)/" />
    </ItemGroup>
  </Target>
</Project>
