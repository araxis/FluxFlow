<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.0.0-alpha.1</Version>
    <PackageId>FluxFlow.Components.Resilience</PackageId>
    <AssemblyName>FluxFlow.Components.Resilience</AssemblyName>
    <RootNamespace>FluxFlow.Components.Resilience</RootNamespace>
    <Description>Request/reply retry components for FluxFlow using Microsoft.Extensions.Resilience.</Description>
    <PackageTags>workflow;dataflow;components;retry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Development preview: independent request attempts with Microsoft.Extensions.Resilience and its underlying retry policies.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../FluxFlow.Core/FluxFlow.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
