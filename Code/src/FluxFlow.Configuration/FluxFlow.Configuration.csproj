<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>1.0.0-alpha.1</Version>
    <PackageId>FluxFlow.Configuration</PackageId>
    <AssemblyName>FluxFlow.Configuration</AssemblyName>
    <RootNamespace>FluxFlow.Configuration</RootNamespace>
    <PackageTags>workflow;dataflow;configuration;composition</PackageTags>
    <Description>Configuration binding and component registration for FluxFlow applications.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Development preview: direct IConfiguration section registration for components, with optional expression engines and native DI resources.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <ProjectReference Include="../FluxFlow.Application/FluxFlow.Application.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
