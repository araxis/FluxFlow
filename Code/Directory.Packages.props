<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="NATS.Client.Core" Version="3.3.2" />
    <PackageVersion Include="NATS.Client.JetStream" Version="3.3.2" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" Condition="'$(TargetFramework)' == 'net8.0-windows10.0.17763.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.120" Condition="'$(TargetFramework)' != 'net8.0-windows10.0.17763.0'" />
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Markdig" Version="1.4.2" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="System.Text.Json" Version="10.0.10" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="8.0.32" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="Jsonata.Net.Native" Version="3.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.32" Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net8.0'))" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" Condition="!$([System.String]::Copy('$(TargetFramework)').StartsWith('net8.0'))" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.27" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="MudBlazor" Version="9.6.0" />
    <PackageVersion Include="Z.Blazor.Diagrams" Version="3.0.4.1" />
    <PackageVersion Include="Z.Blazor.Diagrams.Core" Version="3.0.4.1" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.12" />
    <PackageVersion Include="Polly.Core" Version="8.4.2" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="MQTTnet.Server" Version="5.2.0.1603" />
    <PackageVersion Include="MQTTnet.AspNetCore" Version="5.2.0.1603" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Rcl.NET" Version="2.1.2" />
    <PackageVersion Include="DynamicExpresso.Core" Version="2.19.3" />
    <PackageVersion Include="Jsonata.Net.Native.SystemTextJson" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Microsoft.Extensions.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="Google.Protobuf" Version="3.34.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.85.0" />
    <PackageVersion Include="Duende.IdentityModel" Version="8.1.0" />
    <PackageVersion Include="Duende.AccessTokenManagement" Version="4.2.0" />
    <PackageVersion Include="System.Threading.Tasks.Dataflow" Version="9.0.4" />
    <!-- A host-owned limiter must have the same type identity as the host framework's RateLimiter. -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.7" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Keep existing library/plugin assets on their original dependency versions. -->
  <ItemGroup Condition="$([System.String]::Copy('$(TargetFramework)').StartsWith('net11.0'))">
    <PackageVersion Update="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
    <PackageVersion Update="Microsoft.AspNetCore.Components.WebView.Wpf" Version="11.0.10" />
    <PackageVersion Update="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Update="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Update="System.Text.Json" Version="11.0.0" />
    <PackageVersion Update="System.Threading.RateLimiting" Version="11.0.0" />
  </ItemGroup>
</Project>
