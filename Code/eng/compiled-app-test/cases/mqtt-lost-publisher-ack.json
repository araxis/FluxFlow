{
  "configuration": {
    "Resources": {
      "broker": {
        "Type": "mqtt.client",
        "Host": "127.0.0.1",
        "Port": 1883,
        "AutoConnect": false,
        "ClientId": "trial-workflow",
        "CleanSession": true
      },
      "sender": {
        "Type": "mqtt.client",
        "Host": "127.0.0.1",
        "Port": 1883,
        "AutoConnect": false,
        "ClientId": "trial-publisher",
        "CleanSession": true,
        "Reconnect": {
          "MaxRetryAttempts": 3,
          "Delay": "00:00:00.100",
          "BackoffType": "Constant",
          "UseJitter": false
        }
      }
    },
    "Workflows": {
      "main": {
        "tick": {
          "Type": "scheduler",
          "Interval": "00:00:00.800",
          "Output": "commands.Input"
        },
        "commands": {
          "Type": "source",
          "Values": "[{\"Command\":\"Connect\"}]",
          "Output": "connection.Input"
        },
        "connection": {
          "Type": "mqtt.connection",
          "Connection": "Resources.broker",
          "Output": "startSender.Input"
        },
        "publish": {
          "Type": "mqtt.publisher",
          "Connection": "Resources.sender",
          "Output": "outcome.Input"
        },
        "receive": {
          "Type": "mqtt.subscriber",
          "Connection": "Resources.broker",
          "Topics": [
            {
              "Topic": "trial/+",
              "QoS": 1
            }
          ],
          "AcknowledgementMode": "Manual",
          "MaxPendingAcknowledgements": 2,
          "Output": [
            "receive.ACK",
            "format.Input"
          ]
        },
        "format": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'LogLevel':'Information','MessageTemplate':\"Received {Body} at QoS {QoS}\",'Args':[Text,QoS]}",
          "Output": "record.Input"
        },
        "record": {
          "Type": "logger",
          "Category": "Trial.LostPuback"
        },
        "startSender": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'Command':'Connect'}",
          "Output": "sender.Input"
        },
        "sender": {
          "Type": "mqtt.connection",
          "Connection": "Resources.sender",
          "Events": {
            "Address": "next.Input",
            "Condition": "Name='mqtt.connected'",
            "Engine": "jsonata"
          }
        },
        "next": {
          "Type": "source",
          "Values": "[{\"Topic\": \"trial/uncertain\", \"QoS\": 1, \"Payload\": \"B\"}, {\"Topic\": \"trial/confirmed\", \"QoS\": 1, \"Payload\": \"C\"}]",
          "Output": "publish.Input"
        },
        "outcome": {
          "Type": "mapper",
          "Engine": "jsonata",
          "HandleErrors": true,
          "Expression": "{'LogLevel':'Information','MessageTemplate':'Publish {Outcome}','Args':[Code ? Code : Topic]}",
          "Output": "record.Input"
        }
      }
    }
  },
  "edits": {
    "main.receive": {
      "MaxPendingAcknowledgements": 1
    }
  },
  "files": {},
  "category": "Trial.LostPuback",
  "loggerOutput": "main.record.Output",
  "messages": [
    "Publish node.processing_failed",
    "Received B at QoS 1",
    "Publish trial/confirmed",
    "Received C at QoS 1"
  ],
  "pluginFamilies": [
    "Mqtt"
  ],
  "mosquitto": true,
  "ordered": false,
  "dropPublisherAck": true
}
