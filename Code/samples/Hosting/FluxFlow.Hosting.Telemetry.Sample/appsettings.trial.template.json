{
  "FluxFlow": {
    "Resources": {
      "broker": {
        "Type": "mqtt.client",
        "Address": "<MQTT_ADDRESS>",
        "ClientId": "<UNIQUE_CLIENT_ID>",
        "AutoConnect": true,
        "Timeout": "00:00:10",
        "Reconnect": { "Delay": "00:00:01" }
      },
      "api": {
        "Type": "http.client",
        "BaseAddress": "<HTTP_BASE_URL_WITH_TRAILING_SLASH>",
        "Headers": {},
        "Timeout": "00:00:10"
      }
    },
    "Workflows": {
      "telemetry": {
        "connection": {
          "Type": "mqtt.connection",
          "Connection": "broker",
          "Error": "errorRequest.Input"
        },
        "receive": {
          "Type": "mqtt.subscriber",
          "Connection": "broker",
          "Topics": { "Topic": "<MQTT_TOPIC>", "QoS": 1 },
          "Output": "request.Input"
        },
        "request": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'Method':'POST','RequestUrl':'<HTTP_REQUEST_PATH>','Headers':{'X-Flow-Message-Id':$messageId},'Body':{'deviceId':'<DEVICE_ID>','temperature':$number(Text),'unit':'<UNIT>','messageId':$messageId,'traceId':$traceId}}",
          "Output": "send.Input"
        },
        "send": {
          "Type": "http.client",
          "Client": "api",
          "Error": "errorRequest.Input"
        },
        "errorRequest": {
          "Type": "mapper",
          "Engine": "jsonata",
          "HandleErrors": true,
          "Expression": "{'LogLevel':'Error','MessageTemplate':'Telemetry failure {Code}: {ErrorMessage} (trace {TraceId}, message {MessageId})','Args':[Code,Message,$traceId,$messageId],'Attributes':{'Category':Category,'IsTransient':IsTransient,'Details':Details,'CorrelationId':$correlationId,'CausationId':$causationId}}",
          "Output": "log.Input"
        },
        "log": {
          "Type": "logger"
        }
      }
    }
  }
}
