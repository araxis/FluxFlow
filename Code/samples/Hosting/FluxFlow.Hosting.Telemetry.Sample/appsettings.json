{
  "FluxFlow": {
    "Resources": {
      "broker": {
        "Type": "mqtt.client",
        "Address": "mqtt://127.0.0.1:1883",
        "ClientId": "fluxflow-telemetry-sample",
        "AutoConnect": true,
        "Timeout": "00:00:02",
        "Reconnect": { "Delay": "00:00:01" }
      },
      "api": {
        "Type": "http.client",
        "BaseAddress": "http://127.0.0.1:5090/",
        "Timeout": "00:00:02"
      }
    },
    "Workflows": {
      "telemetry": {
        "connection": {
          "Type": "mqtt.connection",
          "Connection": "broker",
          "Error": "errorRequest.Input"
        },
        "receive": {
          "Type": "mqtt.subscriber",
          "Connection": "broker",
          "Topics": { "Topic": "sensors/+/temperature", "QoS": 1 },
          "Output": "request.Input"
        },
        "request": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'Method':'POST','RequestUrl':'readings','Headers':{'X-Flow-Message-Id':$messageId},'Body':{'deviceId':$split(Topic,'/')[1],'temperature':$number(Text),'unit':'C','messageId':$messageId,'traceId':$traceId}}",
          "Output": "send.Input"
        },
        "send": {
          "Type": "http.client",
          "Client": "api",
          "Error": "errorRequest.Input"
        },
        "errorRequest": {
          "Type": "mapper",
          "Engine": "jsonata",
          "HandleErrors": true,
          "Expression": "{'LogLevel':'Error','MessageTemplate':'Telemetry failure {Code}: {ErrorMessage} (trace {TraceId}, message {MessageId})','Args':[Code,Message,$traceId,$messageId],'Attributes':{'Category':Category,'IsTransient':IsTransient,'Details':Details,'CorrelationId':$correlationId,'CausationId':$causationId}}",
          "Output": "log.Input"
        },
        "log": {
          "Type": "logger"
        }
      }
    }
  },
  "SerialTelemetry": {
    "Resources": {
      "api": {
        "Type": "http.client",
        "BaseAddress": "http://127.0.0.1:5090/",
        "Timeout": "00:00:02"
      }
    },
    "Workflows": {
      "telemetry": {
        "Resources": {
          "port": {
            "Type": "serial.port",
            "PortName": "COM3",
            "BaudRate": 115200
          }
        },
        "receive": {
          "Type": "serial.text",
          "Connection": "port",
          "Output": "request.Input"
        },
        "request": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'Method':'POST','RequestUrl':'readings','Headers':{'X-Flow-Message-Id':$messageId},'Body':{'DeviceId':'serial-sensor','Temperature':$number($),'Unit':'C','MessageId':$messageId,'TraceId':$traceId}}",
          "Output": "send.Input"
        },
        "send": {
          "Type": "http.client",
          "Client": "api",
          "Error": "errorRequest.Input"
        },
        "errorRequest": {
          "Type": "mapper",
          "Engine": "jsonata",
          "HandleErrors": true,
          "Expression": "{'LogLevel':'Error','MessageTemplate':'Telemetry failure {Code}: {ErrorMessage} (trace {TraceId}, message {MessageId})','Args':[Code,Message,$traceId,$messageId],'Attributes':{'Category':Category,'IsTransient':IsTransient,'Details':Details,'CorrelationId':$correlationId,'CausationId':$causationId}}",
          "Output": "log.Input"
        },
        "log": {
          "Type": "logger"
        }
      }
    }
  }
}
