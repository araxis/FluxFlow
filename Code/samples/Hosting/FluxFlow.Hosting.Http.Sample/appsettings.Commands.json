{
  "FluxFlow": {
    "Resources": {
      "broker": {
        "Type": "mqtt.client",
        "Address": "mqtt://127.0.0.1:1883",
        "ClientId": "fluxflow-http-commands-sample",
        "AutoConnect": true,
        "Timeout": "00:00:02",
        "Reconnect": { "Delay": "00:00:01" }
      }
    },
    "Workflows": {
      "commands": {
        "connection": {
          "Type": "mqtt.connection",
          "Connection": "broker"
        },
        "receive": {
          "Type": "http.trigger",
          "Route": "/devices/{id}/commands",
          "Methods": ["POST"],
          "ResponseMode": "Reply",
          "ReplyTimeout": "00:00:05",
          "Output": "request.Input",
          "Response": "reply.Output"
        },
        "request": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "($assert($type(Body.Command) = 'string' and Body.Command != '', 'Command must be a nonempty string'); {'Topic':'devices/' & $encodeUrlComponent(RouteValues.id) & '/commands','Payload':$string({'Command':Body.Command,'Arguments':Body.Arguments,'MessageId':$messageId,'TraceId':$traceId}),'QoS':1,'Retain':false})",
          "Output": "publish.Input"
        },
        "publish": {
          "Type": "mqtt.publisher",
          "Connection": "broker",
          "Output": "reply.Input"
        },
        "reply": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'StatusCode':200,'Body':{'Topic':Topic,'ReasonCode':ReasonCode,'TraceId':$traceId}}"
        }
      }
    }
  }
}
