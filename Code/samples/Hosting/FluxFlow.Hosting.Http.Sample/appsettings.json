{
  "Urls": "http://127.0.0.1:5080",
  "FluxFlow": {
    "Resources": {
      "downstream": {
        "Type": "http.client",
        "BaseAddress": "http://127.0.0.1:5090/",
        "Timeout": "00:00:02"
      }
    },
    "Workflows": {
      "api": {
        "receive": {
          "Type": "http.trigger",
          "Route": "/devices/{id}/readings",
          "Methods": ["POST"],
          "ResponseMode": "Reply",
          "ShutdownMode": "Drain",
          "ReplyTimeout": "00:00:05",
          "Output": "reply.Input",
          "Response": "reply.Output"
        },
        "reply": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'StatusCode':200,'Headers':{'X-Device-Id':RouteValues.id},'Body':{'deviceId':RouteValues.id,'reading':Body.value,'unit':Body.unit,'messageId':$messageId,'traceId':$traceId}}"
        }
      },
      "gateway": {
        "receive": {
          "Type": "http.trigger",
          "Route": "/gateway/devices/{id}/readings",
          "Methods": ["POST"],
          "ResponseMode": "Reply",
          "ReplyTimeout": "00:00:05",
          "Output": "request.Input",
          "Response": "reply.Output"
        },
        "request": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'Method':'POST','RequestUrl':'devices/' & $encodeUrlComponent(RouteValues.id) & '/readings','Headers':{'X-Flow-Message-Id':$messageId},'Body':{'deviceId':RouteValues.id,'value':Body.value,'unit':Body.unit}}",
          "Output": "send.Input"
        },
        "send": {
          "Type": "http.client",
          "Client": "downstream",
          "Output": "reply.Input"
        },
        "reply": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'StatusCode':StatusCode,'Body':Body,'ContentType':$lookup(Headers,'Content-Type')[0]}"
        }
      },
      "uploads": {
        "receive": {
          "Type": "http.trigger",
          "Route": "/uploads",
          "Methods": ["POST"],
          "ResponseMode": "Reply",
          "ReplyTimeout": "00:00:05",
          "Output": "reply.Input",
          "Response": "reply.Output"
        },
        "reply": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "{'StatusCode':200,'Body':{'fields':Form,'files':[Files.{'name':Name,'fileName':FileName,'contentType':ContentType,'length':Length}],'messageId':$messageId,'traceId':$traceId}}"
        }
      }
    }
  },
  "SerialCommands": {
    "Workflows": {
      "commands": {
        "Resources": {
          "port": {
            "Type": "serial.port",
            "PortName": "COM3",
            "BaudRate": 115200
          }
        },
        "receive": {
          "Type": "http.trigger",
          "Route": "/serial/commands",
          "Methods": ["POST"],
          "ResponseMode": "Acknowledge",
          "Output": "request.Input"
        },
        "request": {
          "Type": "mapper",
          "Engine": "jsonata",
          "Expression": "($assert($type(Body.Text) = 'string', 'Text must be a string'); {'Text':Body.Text})",
          "Output": "serial.Input"
        },
        "serial": {
          "Type": "serial.text",
          "Connection": "port",
          "Error": "errorRequest.Input"
        },
        "errorRequest": {
          "Type": "mapper",
          "Engine": "jsonata",
          "HandleErrors": true,
          "Expression": "{'LogLevel':'Error','MessageTemplate':'Serial command failure {Code}: {ErrorMessage} (trace {TraceId}, message {MessageId})','Args':[Code,Message,$traceId,$messageId]}",
          "Output": "log.Input"
        },
        "log": {
          "Type": "logger"
        }
      }
    }
  }
}
