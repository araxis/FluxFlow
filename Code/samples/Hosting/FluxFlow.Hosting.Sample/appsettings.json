{
  "FluxFlow": {
    "Workflows": {
      "main": {
        "clock": {
          "Type": "scheduler",
          "Interval": "00:00:00.250",
          "Output": "generate.Input"
        },
        "generate": {
          "Type": "dataGenerator",
          "Expression": "{'sensor': 'temperature', 'value': $fakeDecimal(18, 25), 'unit': 'C'}",
          "Output": "report.Input"
        },
        "report": {
          "Type": "readingReporter"
        }
      },
      "background": {
        "clock": {
          "Type": "scheduler",
          "Interval": "00:00:00.250",
          "Output": "generate.Input"
        },
        "generate": {
          "Type": "dataGenerator",
          "Expression": "{'sensor': 'voltage', 'value': $fakeDecimal(12, 13), 'unit': 'V'}",
          "Output": "report.Input"
        },
        "report": {
          "Type": "readingReporter"
        }
      }
    }
  }
}
